* ============================================================
* DDM NAME  : MRD-COREBKG-TXNHIST
* ADABAS    : FILE 150
* PREDICT   : Library MRDDDMLIB
* NUCLEUS   : ADANUC
* OWNER     : CORE BANKING (MRDCBLIB)
* READERS   : FRAUD (MRDFDLIB), REPORTING (MRDRPLIB) — read-only
* RECORDS   : ~820,000,000 (7-year rolling window)
* BLOCK SZ  : 8192 bytes (larger block for high-volume sequential reads)
* RETENTION : 7 years online, then archive to FILE 600 via CBSTP013.
* CHANGED   : 1989-11-01  File 150 created
*             1994-02-10  Migrated to Natural DDM
*             2008-07-22  BALANCE-AFTER caution added (post incident)
*             2018-03-01  Added BG FRAUD-SCORE, BH FRAUD-REVIEW-FLAG
*             2021-09-15  Added BQ ARCHIVE-FLAG for CBSTP013
* ============================================================

DB=150

FIELD=AA, 11, A, DE         /* TRANSACTION-ID
                              /* Unique descriptor. Format: YYYYMMDDHHMMSS+SEQ(6).
                              /* Generated by CBTXS001. Never set by caller.

FIELD=AB, 11, A, DE         /* ACCOUNT-NUMBER
                              /* -> FILE 100 AA. Primary batch access.

FIELD=AC, 10, A, DE         /* CUSTOMER-ID
                              /* Denormalised from FILE 100 at post time.
                              /* Avoids FILE 100 join in fraud cross-acct reads.

FIELD=AD,  8, P, DE         /* VALUE-DATE
                              /* YYYYMMDD. Used for interest calc ranges.

FIELD=AE,  8, P, DE         /* POSTING-DATE

FIELD=AF,  8, P, DE         /* BUSINESS-DATE
                              /* Bank business date (may differ from AE at EOD).

FIELD=AG,  4, A, DE         /* TRANSACTION-TYPE-CODE
                              /* DPSC WDSC DPCH DPRT DPNF CNIN CNCH CNTD CNRV etc.

FIELD=AH, 40, A, NV         /* TRANSACTION-TYPE-DESC

FIELD=AI,  1, A, DE,FI      /* DR-CR-INDICATOR  D=Debit C=Credit
                              /* FI: frequent range reads on debit/credit splits.

FIELD=AJ, 15, P, NV         /* AMOUNT  (always positive)

FIELD=AK,  3, A             /* CURRENCY-CODE  (transaction currency)

FIELD=AL,  3, A, NV         /* ACCOUNT-CURRENCY  (base currency of account)

FIELD=AM, 12, P, NV         /* EXCHANGE-RATE  (6 decimal places)

FIELD=AN, 15, P, NV         /* AMOUNT-IN-ACCOUNT-CCY

FIELD=AO, 15, P, NV         /* BALANCE-AFTER
                              /* SNAPSHOT only. See DDM CAUTION in CBTXL001.lda.
                              /* Never used to recompute account balance.

FIELD=AP, 40, A, NV         /* NARRATIVE-LINE-1

FIELD=AQ, 40, A, NV         /* NARRATIVE-LINE-2

FIELD=AR, 20, A, DE,NV      /* REFERENCE-NUMBER

FIELD=AS, 20, A, DE,NV      /* PAYMENT-ID  -> FILE 300 PA

FIELD=AT,  4, A, DE         /* CHANNEL-CODE

FIELD=AU,  8, A, DE,NV      /* TERMINAL-ID

FIELD=AV,  8, A, DE,NV      /* TELLER-ID

FIELD=AW,  8, A, NV         /* AUTHORISER-ID

FIELD=AX,  1, A, DE,FI      /* REVERSAL-FLAG  Y/N

FIELD=AY, 20, A, DE,NV      /* ORIGINAL-TRANSACTION-ID  (self-ref for reversals)

FIELD=AZ,  4, A, NV         /* REVERSAL-REASON-CODE

FIELD=BA, 12, A, DE,NV      /* GL-ENTRY-REFERENCE  -> FILE 105 GA

FIELD=BB,  2, A, NV         /* GL-POSTING-STATUS  PS PE ER

FIELD=BC,  8, A, DE,NV      /* CHEQUE-NUMBER

FIELD=BD,  4, A, NV         /* CHEQUE-STATUS

FIELD=BE,  8, A, NV         /* BATCH-JOB-NAME

FIELD=BF,  8, P, NV         /* BATCH-JOB-DATE

FIELD=BG,  5, P, NV         /* FRAUD-SCORE  0-999
                              /* Written POST-INSERT by FDSCP010 batch.
                              /* Blank at insert time.

FIELD=BH,  1, A, DE,NV      /* FRAUD-REVIEW-FLAG  Y/N

FIELD=BI, 15, P, NV         /* TAX-AMOUNT

FIELD=BJ, 20, A, NV         /* TAX-REFERENCE

FIELD=BK, 15, P, NV         /* CHARGE-AMOUNT

FIELD=BL, 15, P, NV         /* INTEREST-COMPONENT

FIELD=BM, 12, A, DE,NV      /* LOAN-ACCOUNT-NUMBER  -> FILE 200 LA

FIELD=BN, 16, A, DE,NV      /* STANDING-ORDER-REF

FIELD=BO,  6, P, NV         /* STATEMENT-SEQUENCE

FIELD=BP,  8, P, DE,NV      /* STATEMENT-DATE

FIELD=BQ,  1, A, DE,FI      /* ARCHIVE-FLAG  N=Online A=Archived
                              /* Set to A by CBSTP013 before archive move.

* -- AUDIT ---------------------------------------------------
FIELD=BR, 26, A, NC,FI      /* CREATED-TIMESTAMP
FIELD=BS,  8, A, NC,NV      /* LAST-UPDATED-BY
FIELD=BT, 26, A, NC,NV      /* LAST-UPDATED-TIMESTAMP
FIELD=BU,  8, A, NC,NV      /* LAST-UPDATED-PROGRAM

* -- SUPERDESCRIPTORS -----------------------------------------
SUPER=SU-ACCT-DATE,   AB(1,11), AE(1,8)
  /* Primary batch access path: account + date range.
  /* Used by CBGLP001, CBSTP010, and FDALP010.

SUPER=SU-ACCT-VALDATE, AB(1,11), AD(1,8)
  /* Account + value date. Used by CBICP001 interest calc.

SUPER=SU-CUST-DATE,   AC(1,10), AE(1,8)
  /* Customer + date. Used by FDALP010 cross-account fraud analysis.

SUPER=SU-TYPE-DATE,   AG(1,4),  AE(1,8)
  /* Transaction type + date. Used by volume and channel reports.

SUPER=SU-REVFLAG-DATE, AX(1,1), AE(1,8)
  /* Reversal flag + date. Used by CBTXP002 reversal audit.
