* ============================================================
* NAME     : CBTXL001
* TYPE     : Local Data Area (LDA)
* LIBRARY  : MRDCBLIB
* OBJECT   : CBTXL001
* PURPOSE  : Working-storage image of FILE 150 (TRANSACTION HISTORY).
*            INCLUDE'd by programs that post or read transactions.
*            Used for both INSERT (STORE) and read operations.
* PREDICT  : Registered under MRDDDMLIB
* USED BY  : CBTXP001, CBTXP010, CBTXS001, CBTXVD01, CBGLP001,
*            CBSTBT01 (statement batch)
* CHANGED  : 1994-02-10  Initial creation
*            2008-07-22  Fixed BALANCE-AFTER misuse in CBTXP002
*            2018-03-01  Added ECL/IFRS9 fraud score fields
* CAUTION  : BALANCE-AFTER (field AO) is a SNAPSHOT set at post time.
*            Programs must NEVER reconstruct account balance by
*            summing transaction amounts. This caused the 2007 incident
*            where CBTXP002 computed stale balances for 2,200 accounts.
*            Always read #CURRENT-BALANCE from FILE 100 directly.
* ============================================================
DEFINE DATA LOCAL

  1 #TRANSACTION-RECORD

    * -- Transaction Identity ------------------------------------
    2 #TRANSACTION-ID               (A20)
      /* FILE 150 AA. System-generated by CBTXS001 on STORE.
      /* Format: YYYYMMDDHHMMSSSSSSSS (date+time+6-digit seq).
      /* Never set by caller — always left blank on input to CBTXS001.
    2 #ACCOUNT-NUMBER               (A11)
      /* FILE 150 AB. -> FILE 100 AA. Must exist and be AC before post.
    2 #CUSTOMER-ID                  (A10)
      /* FILE 150 AC. Denormalised from FILE 100 at post time.
      /* Stored to avoid FILE 100 read in fraud cross-account queries.

    * -- Dates ---------------------------------------------------
    2 #VALUE-DATE                   (P8)
      /* FILE 150 AD. YYYYMMDD. Used for interest calculation ranges.
      /* May be prior business day for back-valued transactions.
    2 #POSTING-DATE                 (P8)
      /* FILE 150 AE. Actual date the posting was processed.
    2 #BUSINESS-DATE               (P8)
      /* FILE 150 AF. Bank business date from GDA #SYS-BUSINESS-DATE.

    * -- Transaction Classification ------------------------------
    2 #TRANSACTION-TYPE-CODE        (A4)
      /* FILE 150 AG. See type table in blueprint Section 1.3.
      /* Examples: DPSC WDSC DPCH DPRT DPNF CNIN CNCH CNTD CNRV
    2 #TRANSACTION-TYPE-DESC        (A40)
      /* FILE 150 AH. Derived from FILE 015 parameter table at post.
    2 #DR-CR-INDICATOR              (A1)
      /* FILE 150 AI. D=Debit  C=Credit. ALWAYS populated.
      /* Amounts are ALWAYS stored positive — sign is here.
    2 #CHANNEL-CODE                 (A4)
      /* FILE 150 AT. TELL=Teller ATM=ATM MOB=Mobile INT=Internet
      /*              RTGS=RTGS NEFT=NEFT SWFT=SWIFT CARD=Card
      /*              STDO=StandingOrder DDBT=DirectDebit

    * -- Amounts (ALWAYS POSITIVE — sign in DR-CR-INDICATOR) ----
    2 #AMOUNT                       (P15)
      /* FILE 150 AJ. Transaction currency amount. Always >= 0.
    2 #CURRENCY-CODE                (A3)
      /* FILE 150 AK. Transaction (may differ from account currency).
    2 #ACCOUNT-CURRENCY             (A3)
      /* FILE 150 AL. Account's base currency (from FILE 100 AH).
    2 #EXCHANGE-RATE                (P12)
      /* FILE 150 AM. 6 decimal places. 1.000000 if same currency.
    2 #AMOUNT-IN-ACCOUNT-CCY        (P15)
      /* FILE 150 AN. = AMOUNT * EXCHANGE-RATE (converted amount).
    2 #BALANCE-AFTER                (P15)
      /* FILE 150 AO. Account balance snapshot AFTER this posting.
      /* READ-ONLY after insert — see CAUTION above.

    * -- Tax and Charges ----------------------------------------
    2 #TAX-AMOUNT                   (P15)
      /* FILE 150 BI. TDS deducted if TAX-WITHHOLDING-FLAG=Y.
    2 #TAX-REFERENCE                (A20)
      /* FILE 150 BJ. TDS challan reference.
    2 #CHARGE-AMOUNT                (P15)
      /* FILE 150 BK. Service charge posted with this transaction.
    2 #INTEREST-COMPONENT           (P15)
      /* FILE 150 BL. For interest posting transactions only.

    * -- Narrative and Reference --------------------------------
    2 #NARRATIVE-LINE-1             (A40)
      /* FILE 150 AP. First line of transaction description.
    2 #NARRATIVE-LINE-2             (A40)
      /* FILE 150 AQ. Second line. Blank if single-line narrative.
    2 #REFERENCE-NUMBER             (A20)
      /* FILE 150 AR. Cheque number, payment ref, or batch ref.

    * -- Cross-Domain Links -------------------------------------
    2 #PAYMENT-ID                   (A20)
      /* FILE 150 AS. -> FILE 300 PA. Blank if not a payment.
    2 #LOAN-ACCOUNT-NUMBER          (A12)
      /* FILE 150 BM. -> FILE 200 LA. Populated for loan repayments.
    2 #STANDING-ORDER-REF           (A16)
      /* FILE 150 BN. -> FILE 125. Populated for standing orders.

    * -- Reversal Control ----------------------------------------
    2 #REVERSAL-FLAG                (A1)
      /* FILE 150 AX. Y=This record is a reversal N=Normal posting.
    2 #ORIGINAL-TRANSACTION-ID      (A20)
      /* FILE 150 AY. -> FILE 150 AA (self-ref). Set for reversals.
    2 #REVERSAL-REASON-CODE         (A4)
      /* FILE 150 AZ. CLER=Clerk error CUST=Customer SYST=System

    * -- GL Linkage ---------------------------------------------
    2 #GL-ENTRY-REFERENCE           (A12)
      /* FILE 150 BA. -> FILE 105 GA. Set by CBGLS001 after GL post.
    2 #GL-POSTING-STATUS            (A2)
      /* FILE 150 BB. PS=Posted PE=Pending ER=Error

    * -- Cheque Fields ------------------------------------------
    2 #CHEQUE-NUMBER                (A8)
      /* FILE 150 BC. Blank if not a cheque transaction.
    2 #CHEQUE-STATUS                (A4)
      /* FILE 150 BD. PRES CLER RTRN STOP STOL

    * -- Terminal and Operator ----------------------------------
    2 #TERMINAL-ID                  (A8)
      /* FILE 150 AU. Teller terminal or ATM ID.
    2 #TELLER-ID                    (A8)
      /* FILE 150 AV. Teller user ID. Blank for batch/system.
    2 #AUTHORISER-ID                (A8)
      /* FILE 150 AW. Dual-control authoriser. Blank if not required.

    * -- Fraud Fields (written POST-INSERT by FDSCP010) ----------
    2 #FRAUD-SCORE                  (P5)
      /* FILE 150 BG. 0-999. Written by Fraud batch FDSCP010 after EOD.
      /* NOT set by Core Banking programs at post time.
    2 #FRAUD-REVIEW-FLAG            (A1)
      /* FILE 150 BH. Y=Referred to fraud team for investigation.

    * -- Statement ----------------------------------------------
    2 #STATEMENT-SEQUENCE           (P6)
      /* FILE 150 BO. Sequence number on printed/electronic statement.
    2 #STATEMENT-DATE               (P8)
      /* FILE 150 BP. Date of statement that included this transaction.

    * -- Batch Tracking -----------------------------------------
    2 #BATCH-JOB-NAME               (A8)
      /* FILE 150 BE. JCL job name. Blank for online transactions.
    2 #BATCH-JOB-DATE               (P8)
      /* FILE 150 BF. Business date of the batch run.

    * -- Audit --------------------------------------------------
    2 #CREATED-TIMESTAMP            (A26)
      /* FILE 150 BR. Set by CBTXS001 on STORE. Never set by caller.
    2 #LAST-UPDATED-BY              (A8)
      /* FILE 150 BS.
    2 #LAST-UPDATED-TIMESTAMP       (A26)
      /* FILE 150 BT.
    2 #LAST-UPDATED-PROGRAM         (A8)
      /* FILE 150 BU.

  * -- Working fields (NOT stored in ADABAS) ------------------
  1 #TRANSACTION-WORK
    2 #TXN-FOUND-FLAG               (A1)
      /* Y = Record found in FILE 150. N = Not found.
    2 #TXN-IS-REVERSAL              (A1)
      /* Y if #REVERSAL-FLAG = 'Y'. Derived.
    2 #TXN-IS-CROSS-CURRENCY        (A1)
      /* Y if #CURRENCY-CODE != #ACCOUNT-CURRENCY.
    2 #TXN-NET-EFFECT               (P15)
      /* Signed amount: negative=debit positive=credit.
      /* Derived as: AMOUNT * (D=-1 / C=+1).
    2 #TXN-ADABAS-ISN               (P10)
      /* ADABAS ISN of found transaction record.

END-DEFINE
