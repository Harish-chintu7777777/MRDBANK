* ============================================================
* NAME     : LNRPA001
* TYPE     : Parameter Data Area (PDA)
* LIBRARY  : MRDLNLIB
* OBJECT   : LNRPA001
* PURPOSE  : CALLNAT interface contract for LNRPS001 (Loan Repayment
*            Subprogram). Defines the inputs and outputs for posting
*            a loan repayment, including principal + interest allocation
*            and resultant GL entries.
* PREDICT  : Registered under MRDDDMLIB
* USED BY  : LNMOP001  (online repayment entry — future screen)
*            LNRPP011  (batch repayment poster)
*            CBSOP011  (standing order executor — auto EMI debit)
*            CBDDP001  (direct debit processor)
* CHANGED  : 1994-06-15  Initial creation.
*            2008-09-12  Added P-PAYMENT-CHANNEL to align with CBTXA001.
*            2014-11-01  Added P-OVERDUE-* output fields.
*            2019-05-20  Added P-RECORD-VERSION for optimistic locking.
* CAUTION  : Changes require recompile of all callers listed above.
* ============================================================
DEFINE DATA PARAMETER

  * -- Input: Repayment Instruction ----------------------------
  1 #P-LOAN-ACCOUNT-NUMBER           (A12)   /* IN  Loan being repaid
  1 #P-PAYMENT-AMOUNT                (P15)   /* IN  Total amount remitted (always > 0)
  1 #P-PAYMENT-DATE                  (P8)    /* IN  YYYYMMDD value date of payment
  1 #P-PAYMENT-CHANNEL               (A4)    /* IN  TELL ATM MOB INTB STDO DDBT RTGS NEFT
  1 #P-PAYMENT-REFERENCE             (A20)   /* IN  External reference / cheque number
  1 #P-PAYMENT-NARRATIVE             (A40)   /* IN  Free-text narrative for statement
  1 #P-SOURCE-ACCOUNT                (A11)   /* IN  CASA account debited -> FILE 100 AA
                                              /*     Blank if cash payment at teller.
  1 #P-TELLER-ID                     (A8)    /* IN  Blank for non-teller channels
  1 #P-AUTHORISER-ID                 (A8)    /* IN  Supervisor for large payments
  1 #P-RECORD-VERSION                (P5)    /* IN  Optimistic lock from prior LNMOS001 read

  * -- Output: Allocation Results ------------------------------
  1 #P-TRANSACTION-ID                (A20)   /* OUT Generated by CBTXS001 for the debit
  1 #P-PRINCIPAL-APPLIED             (P15)   /* OUT Amount allocated to principal
  1 #P-INTEREST-APPLIED              (P15)   /* OUT Amount allocated to interest
  1 #P-CHARGES-APPLIED               (P15)   /* OUT Amount applied to overdue charges
  1 #P-EXCESS-AMOUNT                 (P15)   /* OUT Overpayment credited to CASA (rare)
  1 #P-OUTSTANDING-AFTER             (P15)   /* OUT Remaining principal balance (display only)
    /* WARNING: Do NOT persist or re-derive. Read FILE 200 for authoritative balance.
  1 #P-INSTALLMENT-NUMBER-CLEARED    (N3)    /* OUT Instalment number marked PD by this payment
  1 #P-NEXT-DUE-DATE-AFTER           (P8)    /* OUT Next EMI due date after this payment
  1 #P-LOAN-STATUS-AFTER             (A2)    /* OUT Status of loan after this posting

  * -- Output: Response ----------------------------------------
  1 #P-RESPONSE-CODE                 (N4)    /* OUT
    /* 0000 = Repayment posted successfully
    /* 1010 = Loan account number blank
    /* 1011 = Loan account not found
    /* 1020 = Loan status invalid for repayment (ST or WO)
    /* 1021 = Payment amount must be greater than zero
    /* 1022 = Payment date cannot be in the future
    /* 1023 = Record version mismatch — concurrent update detected
    /* 1024 = Payment exceeds total outstanding — check P-EXCESS-AMOUNT
    /* 9001 = ADABAS read error on FILE 200
    /* 9002 = ADABAS update error on FILE 200
    /* 9003 = ADABAS update error on FILE 205 (schedule)
    /* 9004 = CBTXS001 error posting debit to CASA — check P-RESPONSE-TEXT

  1 #P-RESPONSE-TEXT                 (A80)   /* OUT Human-readable description
  1 #P-ADABAS-RESPONSE               (N3)    /* OUT Raw ADABAS response code

END-DEFINE
