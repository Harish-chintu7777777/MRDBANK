* ============================================================
* NAME     : LNMOVD01
* TYPE     : Subprogram (CALLNAT target)
* LIBRARY  : MRDLNLIB
* PURPOSE  : Loan creation input validation. Called by LNMOS002
*            before any FILE 200 write. Returns first error found.
* CALLED BY: LNMOS002
* ============================================================
DEFINE DATA
  GLOBAL USING CMDAG001
  PARAMETER
    1 #P-CUSTOMER-ID       (A10)
    1 #P-PRODUCT-CODE      (A6)
    1 #P-LOAN-TYPE         (A4)
    1 #P-CURRENCY-CODE     (A3)
    1 #P-BRANCH-CODE       (A4)
    1 #P-SANCTIONED-AMOUNT (P15)
    1 #P-TENOR-MONTHS      (N3)
    1 #P-INTEREST-RATE     (P7)
    1 #P-RATE-TYPE         (A1)
    1 #P-REPAYMENT-DAY     (N2)
    1 #P-RESPONSE-CODE     (N4)
    1 #P-RESPONSE-TEXT     (A80)
END-DEFINE

MOVE 0 TO #P-RESPONSE-CODE

IF #P-CUSTOMER-ID = ' '
  MOVE 1020 TO #P-RESPONSE-CODE
  MOVE 'CUSTOMER ID IS BLANK' TO #P-RESPONSE-TEXT
  ESCAPE ROUTINE
END-IF

IF #P-PRODUCT-CODE = ' '
  MOVE 1021 TO #P-RESPONSE-CODE
  MOVE 'PRODUCT CODE IS BLANK' TO #P-RESPONSE-TEXT
  ESCAPE ROUTINE
END-IF

IF #P-LOAN-TYPE NE 'TERM' AND #P-LOAN-TYPE NE 'REVO' AND
   #P-LOAN-TYPE NE 'MORT' AND #P-LOAN-TYPE NE 'VEHI' AND
   #P-LOAN-TYPE NE 'PERS' AND #P-LOAN-TYPE NE 'EDUC' AND
   #P-LOAN-TYPE NE 'AGRI' AND #P-LOAN-TYPE NE 'MSME' AND
   #P-LOAN-TYPE NE 'CRED'
  MOVE 1022 TO #P-RESPONSE-CODE
  MOVE 'INVALID LOAN TYPE' TO #P-RESPONSE-TEXT
  ESCAPE ROUTINE
END-IF

IF #P-CURRENCY-CODE = ' '
  MOVE 1023 TO #P-RESPONSE-CODE
  MOVE 'CURRENCY CODE IS BLANK' TO #P-RESPONSE-TEXT
  ESCAPE ROUTINE
END-IF

IF #P-BRANCH-CODE = ' '
  MOVE 1024 TO #P-RESPONSE-CODE
  MOVE 'BRANCH CODE IS BLANK' TO #P-RESPONSE-TEXT
  ESCAPE ROUTINE
END-IF

IF #P-SANCTIONED-AMOUNT <= 0
  MOVE 1025 TO #P-RESPONSE-CODE
  MOVE 'SANCTIONED AMOUNT MUST BE GREATER THAN ZERO' TO #P-RESPONSE-TEXT
  ESCAPE ROUTINE
END-IF

IF #P-TENOR-MONTHS <= 0 OR #P-TENOR-MONTHS > 360
  MOVE 1026 TO #P-RESPONSE-CODE
  MOVE 'TENOR MONTHS MUST BE 1 TO 360' TO #P-RESPONSE-TEXT
  ESCAPE ROUTINE
END-IF

IF #P-INTEREST-RATE <= 0
  MOVE 1027 TO #P-RESPONSE-CODE
  MOVE 'INTEREST RATE MUST BE GREATER THAN ZERO' TO #P-RESPONSE-TEXT
  ESCAPE ROUTINE
END-IF

IF #P-RATE-TYPE NE 'F' AND #P-RATE-TYPE NE 'V'
  MOVE 1028 TO #P-RESPONSE-CODE
  MOVE 'RATE TYPE MUST BE F OR V' TO #P-RESPONSE-TEXT
  ESCAPE ROUTINE
END-IF

IF #P-REPAYMENT-DAY < 1 OR #P-REPAYMENT-DAY > 28
  MOVE 1029 TO #P-RESPONSE-CODE
  MOVE 'REPAYMENT DAY MUST BE 1 TO 28' TO #P-RESPONSE-TEXT
  ESCAPE ROUTINE
END-IF

MOVE 'VALIDATION PASSED' TO #P-RESPONSE-TEXT

END
