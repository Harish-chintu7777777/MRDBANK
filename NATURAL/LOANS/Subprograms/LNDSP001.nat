* ============================================================
* NAME     : LNDSP001
* TYPE     : Subprogram (CALLNAT target)
* LIBRARY  : MRDLNLIB
* PURPOSE  : Loan Disbursement Subprogram. Posts a disbursement
*            tranche to FILE 200, updates outstanding principal,
*            writes a GL debit entry, and records a transaction
*            in FILE 150. Issues ET on success.
* CALLED BY: LNMOP001 (online disbursement)
*            MRDLD001 (batch disbursement job via LNIAP010)
* CALLS    : LNMOS001 (read loan with HOLD)
*            CBTXS001 (post transaction to FILE 150)
*            CBGLS001 (GL disbursement entry)
*            CMUTS007 (audit)
* ============================================================
DEFINE DATA
  GLOBAL USING CMDAG001
  LOCAL  USING LNMOL001
  PARAMETER
    1 #P-LOAN-ACCOUNT-NUMBER  (A12)   /* IN
    1 #P-TRANCHE-AMOUNT       (P15)   /* IN  must be > 0
    1 #P-DISBURSE-DATE        (P8)    /* IN  YYYYMMDD value date
    1 #P-CREDIT-ACCOUNT       (A11)   /* IN  CASA to credit -> FILE 100
    1 #P-NARRATIVE            (A40)   /* IN  free text
    1 #P-RECORD-VERSION       (P5)    /* IN  from prior LNMOS001 read
    1 #P-OUT-TRANSACTION-ID   (A20)   /* OUT generated by CBTXS001
    1 #P-RESPONSE-CODE        (N4)
    1 #P-RESPONSE-TEXT        (A80)
    1 #P-ADABAS-RESPONSE      (N3)
  LOCAL
    1 #LNMOA001-PDA PARAMETER USING LNMOA001
    1 #GL-DR-ACCOUNT  (A12)
    1 #GL-CR-ACCOUNT  (A12)
    1 #GL-RESP        (N4)
    1 #GL-TEXT        (A80)
    1 #GL-REF         (A12)
    1 #TX-RESP        (N4)
    1 #TX-TEXT        (A80)
    1 #AUD-RESP       (N4)
    1 #AUD-TEXT       (A80)
    1 #TRANCHE-IDX    (N1)
    1 #NEW-OUTSTANDING (P15)
END-DEFINE

* ── Validate ───────────────────────────────────────────────
IF #P-LOAN-ACCOUNT-NUMBER = ' '
  MOVE 1010 TO #P-RESPONSE-CODE
  MOVE 'LOAN ACCOUNT NUMBER IS BLANK' TO #P-RESPONSE-TEXT
  ESCAPE ROUTINE
END-IF

IF #P-TRANCHE-AMOUNT <= 0
  MOVE 1021 TO #P-RESPONSE-CODE
  MOVE 'TRANCHE AMOUNT MUST BE GREATER THAN ZERO' TO #P-RESPONSE-TEXT
  ESCAPE ROUTINE
END-IF

IF #P-CREDIT-ACCOUNT = ' '
  MOVE 1022 TO #P-RESPONSE-CODE
  MOVE 'CREDIT ACCOUNT IS BLANK' TO #P-RESPONSE-TEXT
  ESCAPE ROUTINE
END-IF

* ── Read loan with HOLD ────────────────────────────────────
MOVE #P-LOAN-ACCOUNT-NUMBER TO #LNMOA001-PDA.#P-LOAN-ACCOUNT-NUMBER
MOVE 'H'                    TO #LNMOA001-PDA.#P-LOCK-MODE

CALLNAT 'LNMOS001'
  #LNMOA001-PDA.#P-LOAN-ACCOUNT-NUMBER
  #LNMOA001-PDA.#P-LOCK-MODE
  #LNMOA001-PDA.#P-LOAN-RECORD
  #LNMOA001-PDA.#P-RESPONSE-CODE
  #LNMOA001-PDA.#P-RESPONSE-TEXT
  #LNMOA001-PDA.#P-ADABAS-RESPONSE

IF #LNMOA001-PDA.#P-RESPONSE-CODE NE 0
  MOVE #LNMOA001-PDA.#P-RESPONSE-CODE TO #P-RESPONSE-CODE
  MOVE #LNMOA001-PDA.#P-RESPONSE-TEXT TO #P-RESPONSE-TEXT
  ESCAPE ROUTINE
END-IF

* ── Version check ──────────────────────────────────────────
IF #LNMOA001-PDA.#P-LOAN-RECORD.#P-RECORD-VERSION NE #P-RECORD-VERSION
  MOVE 1004 TO #P-RESPONSE-CODE
  MOVE 'VERSION CONFLICT ON LOAN RECORD' TO #P-RESPONSE-TEXT
  BT
  ESCAPE ROUTINE
END-IF

* ── Loan must be SA or DI to accept disbursement ───────────
IF #LNMOA001-PDA.#P-LOAN-RECORD.#P-LOAN-STATUS NE 'SA' AND
   #LNMOA001-PDA.#P-LOAN-RECORD.#P-LOAN-STATUS NE 'DI'
  MOVE 1030 TO #P-RESPONSE-CODE
  MOVE 'LOAN STATUS DOES NOT ALLOW DISBURSEMENT' TO #P-RESPONSE-TEXT
  BT
  ESCAPE ROUTINE
END-IF

* ── Tranche amount must not exceed remaining sanction ───────
COMPUTE #NEW-OUTSTANDING =
  #LNMOA001-PDA.#P-LOAN-RECORD.#P-OUTSTANDING-PRINCIPAL + #P-TRANCHE-AMOUNT

IF #NEW-OUTSTANDING > #LNMOA001-PDA.#P-LOAN-RECORD.#P-SANCTIONED-AMOUNT
  MOVE 1031 TO #P-RESPONSE-CODE
  MOVE 'TRANCHE EXCEEDS REMAINING SANCTIONED AMOUNT' TO #P-RESPONSE-TEXT
  BT
  ESCAPE ROUTINE
END-IF

* ── Post credit to CASA via CBTXS001 ───────────────────────
CALLNAT 'CBTXS001'
  #P-CREDIT-ACCOUNT         /* account to credit
  'CR'                      /* credit side
  #P-TRANCHE-AMOUNT
  #LNMOA001-PDA.#P-LOAN-RECORD.#P-CURRENCY-CODE
  'LNDB'                    /* txn type: Loan Disbursement
  #P-DISBURSE-DATE
  #P-LOAN-ACCOUNT-NUMBER    /* reference
  #P-NARRATIVE
  #P-OUT-TRANSACTION-ID
  #TX-RESP
  #TX-TEXT

IF #TX-RESP NE 0
  MOVE 9003 TO #P-RESPONSE-CODE
  MOVE #TX-TEXT TO #P-RESPONSE-TEXT
  BT
  ESCAPE ROUTINE
END-IF

* ── Update FILE 200 via FIND WITH HOLD ─────────────────────
FIND LN-VIEW WITH HOLD LA = #P-LOAN-ACCOUNT-NUMBER
  IF *ADABAS-RESPONSE NE 0
    MOVE 9001 TO #P-RESPONSE-CODE
    MOVE 'FILE 200 FIND-WITH-HOLD FAILED' TO #P-RESPONSE-TEXT
    BT
    ESCAPE ROUTINE
  END-IF

  /* Update principal balances */
  COMPUTE LN-VIEW.LJ = LN-VIEW.LJ + #P-TRANCHE-AMOUNT
  COMPUTE LN-VIEW.LK = LN-VIEW.LK + #P-TRANCHE-AMOUNT

  /* Set first disbursement date on first tranche */
  IF LN-VIEW.LG = 0
    MOVE #P-DISBURSE-DATE TO LN-VIEW.LG
    /* Next due date = next repayment day after disburse date */
    MOVE #SYS-NEXT-BUSINESS-DATE TO LN-VIEW.LT
  END-IF

  /* Status: SA -> DI if partial; DI -> AC if fully disbursed */
  IF LN-VIEW.LK < LN-VIEW.LI
    MOVE 'DI' TO LN-VIEW.LE
  ELSE
    MOVE 'AC' TO LN-VIEW.LE
  END-IF

  /* Write tranche into next available PE slot */
  MOVE 1 TO #TRANCHE-IDX
  REPEAT
    IF LN-VIEW.DA(#TRANCHE-IDX).DE = ' ' OR
       LN-VIEW.DA(#TRANCHE-IDX).DE = 'CN'
      MOVE #P-DISBURSE-DATE         TO LN-VIEW.DA(#TRANCHE-IDX).DB
      MOVE #P-TRANCHE-AMOUNT        TO LN-VIEW.DA(#TRANCHE-IDX).DC
      MOVE #P-OUT-TRANSACTION-ID    TO LN-VIEW.DA(#TRANCHE-IDX).DD
      MOVE 'DI'                     TO LN-VIEW.DA(#TRANCHE-IDX).DE
      MOVE #P-NARRATIVE             TO LN-VIEW.DA(#TRANCHE-IDX).DF
      ESCAPE BOTTOM
    END-IF
    COMPUTE #TRANCHE-IDX = #TRANCHE-IDX + 1
    IF #TRANCHE-IDX > 6
      ESCAPE BOTTOM
    END-IF
  END-REPEAT

  MOVE #SYS-USER-ID  TO LN-VIEW.FC
  MOVE *TIMX         TO LN-VIEW.FD
  MOVE 'LNDSP001'    TO LN-VIEW.FE
  COMPUTE LN-VIEW.FF = #P-RECORD-VERSION + 1

  UPDATE

  IF *ADABAS-RESPONSE NE 0
    MOVE 9002 TO #P-RESPONSE-CODE
    MOVE 'FILE 200 UPDATE FAILED' TO #P-RESPONSE-TEXT
    BT
    ESCAPE ROUTINE
  END-IF

END-FIND

* ── GL disbursement entry ───────────────────────────────────
MOVE 'LOAN-DISBURSE-DR' TO #GL-DR-ACCOUNT
MOVE 'LOAN-SANCT-SUSP ' TO #GL-CR-ACCOUNT

CALLNAT 'CBGLS001'
  #P-LOAN-ACCOUNT-NUMBER
  'LOAN'
  #GL-DR-ACCOUNT
  #GL-CR-ACCOUNT
  #P-TRANCHE-AMOUNT
  #LNMOA001-PDA.#P-LOAN-RECORD.#P-CURRENCY-CODE
  'LNDI'
  #P-DISBURSE-DATE
  #GL-RESP
  #GL-TEXT
  #GL-REF

IF #GL-RESP NE 0
  MOVE 9004 TO #P-RESPONSE-CODE
  MOVE #GL-TEXT TO #P-RESPONSE-TEXT
  BT
  ESCAPE ROUTINE
END-IF

* ── Audit and commit ───────────────────────────────────────
CALLNAT 'CMUTS007'
  'DISB' 'LOAN' #P-LOAN-ACCOUNT-NUMBER 200
  ' ' #P-OUT-TRANSACTION-ID 'LNDSP001'
  #AUD-RESP #AUD-TEXT

ET

MOVE 0000 TO #P-RESPONSE-CODE
MOVE 'DISBURSEMENT POSTED SUCCESSFULLY' TO #P-RESPONSE-TEXT

END
