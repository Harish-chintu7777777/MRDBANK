* ============================================================
* NAME     : LNMOS001
* TYPE     : Subprogram (CALLNAT target)
* LIBRARY  : MRDLNLIB
* OBJECT   : LNMOS001
* PURPOSE  : Loan Master Read Subprogram. Single point of access for
*            reading FILE 200 (LOAN MASTER). All programs in all
*            domains call this subprogram — none read FILE 200
*            directly. Supports Read-only (R) and Hold (H) modes.
* PREDICT  : PDA LNMOA001
* CALLED BY: LNMOP001 (loan origination online — sanction check, R)
*            LNIQP001 (loan inquiry online, R)
*            LNRPS001 (repayment posting — H mode for balance update)
*            LNIAP001 (accrual — reads rate + outstanding, R)
*            LNDSP001 (disbursement — reads sanction/disbursed, H)
*            LNNPAP01 (NPA batch — reads overdue days + status, R)
*            CBACS001 (core banking — reads MF for BJ linkage, R)
*            PYINR001 (payments — status check before instruction, R)
*            FDSCP010 (fraud — exposure scoring, R)
* DEPENDS  : GDA CMDAG001
*            LDA LNMOL001
*            FILE 200 MRD-LOANS-LOANMSTR (read)
* ADABAS   : FILE 200 — FIND with descriptor LA (LOAN-ACCOUNT-NUMBER).
*            H mode: FIND with HOLD option.
* CALL DEPTH: Level 2 (called by Level 1 drivers and Level 3 engines)
* ============================================================
DEFINE DATA
  GLOBAL   USING CMDAG001
  PARAMETER USING LNMOA001
  LOCAL    USING LNMOL001
END-DEFINE

* ── Input validation ───────────────────────────────────────
IF #P-LOAN-ACCOUNT-NUMBER = ' '
  MOVE 1010 TO #P-RESPONSE-CODE
  MOVE 'LOAN ACCOUNT NUMBER IS BLANK' TO #P-RESPONSE-TEXT
  ESCAPE ROUTINE
END-IF

IF #P-LOCK-MODE NE 'R' AND #P-LOCK-MODE NE 'H'
  MOVE 'R' TO #P-LOCK-MODE          /* Default to read-only if invalid
END-IF

* ── Read from ADABAS FILE 200 ──────────────────────────────
IF #P-LOCK-MODE = 'H'
  FIND LN-VIEW WITH HOLD LA = #P-LOAN-ACCOUNT-NUMBER
    PERFORM POPULATE-OUTPUT
  END-FIND
ELSE
  FIND LN-VIEW LA = #P-LOAN-ACCOUNT-NUMBER
    PERFORM POPULATE-OUTPUT
  END-FIND
END-IF

* ── Check if record was found ──────────────────────────────
IF #P-RESPONSE-CODE = 0
  /* Response still zero — FIND completed without setting it.
  /* This means no record was found.
  MOVE 1011 TO #P-RESPONSE-CODE
  MOVE 'LOAN ACCOUNT NOT FOUND IN FILE 200' TO #P-RESPONSE-TEXT
END-IF

ESCAPE ROUTINE

* ──────────────────────────────────────────────────────────
DEFINE SUBROUTINE POPULATE-OUTPUT
* ──────────────────────────────────────────────────────────
  IF *ADABAS-RESPONSE NE 0
    MOVE *ADABAS-RESPONSE  TO #SYS-LAST-ADABAS-RESPONSE
    MOVE 'LNMOS001'        TO #SYS-LAST-ERROR-PROGRAM
    MOVE 9001              TO #P-RESPONSE-CODE
    MOVE 'ADABAS READ ERROR ON FILE 200' TO #P-RESPONSE-TEXT
    MOVE *ADABAS-RESPONSE  TO #P-ADABAS-RESPONSE
    ESCAPE ROUTINE
  END-IF

  /* Map LN-VIEW fields to PDA output ----------------------
  MOVE LN-VIEW.LA  TO #P-LOAN-RECORD.#P-LOAN-ACCOUNT-NUMBER
  MOVE LN-VIEW.LB  TO #P-LOAN-RECORD.#P-CUSTOMER-ID
  MOVE LN-VIEW.LC  TO #P-LOAN-RECORD.#P-PRODUCT-CODE
  MOVE LN-VIEW.LD  TO #P-LOAN-RECORD.#P-LOAN-TYPE
  MOVE LN-VIEW.LE  TO #P-LOAN-RECORD.#P-LOAN-STATUS
  MOVE LN-VIEW.LF  TO #P-LOAN-RECORD.#P-SANCTION-DATE
  MOVE LN-VIEW.LG  TO #P-LOAN-RECORD.#P-FIRST-DISBURSEMENT-DATE
  MOVE LN-VIEW.LH  TO #P-LOAN-RECORD.#P-MATURITY-DATE
  MOVE LN-VIEW.ML  TO #P-LOAN-RECORD.#P-CURRENCY-CODE
  MOVE LN-VIEW.LI  TO #P-LOAN-RECORD.#P-SANCTIONED-AMOUNT
  MOVE LN-VIEW.LJ  TO #P-LOAN-RECORD.#P-OUTSTANDING-PRINCIPAL
  MOVE LN-VIEW.LK  TO #P-LOAN-RECORD.#P-TOTAL-DISBURSED-AMOUNT
  MOVE LN-VIEW.LL  TO #P-LOAN-RECORD.#P-INTEREST-RATE
  MOVE LN-VIEW.LM  TO #P-LOAN-RECORD.#P-RATE-TYPE
  MOVE LN-VIEW.LN  TO #P-LOAN-RECORD.#P-EMI-AMOUNT
  MOVE LN-VIEW.LO  TO #P-LOAN-RECORD.#P-TENOR-MONTHS
  MOVE LN-VIEW.LS  TO #P-LOAN-RECORD.#P-REPAYMENT-DAY-OF-MONTH
  MOVE LN-VIEW.LT  TO #P-LOAN-RECORD.#P-NEXT-DUE-DATE
  MOVE LN-VIEW.LU  TO #P-LOAN-RECORD.#P-LAST-PAYMENT-DATE
  MOVE LN-VIEW.MN  TO #P-LOAN-RECORD.#P-PENAL-INTEREST-RATE
  MOVE LN-VIEW.LP  TO #P-LOAN-RECORD.#P-INSTALLMENTS-TOTAL
  MOVE LN-VIEW.LQ  TO #P-LOAN-RECORD.#P-INSTALLMENTS-PAID
  MOVE LN-VIEW.LR  TO #P-LOAN-RECORD.#P-INSTALLMENTS-OVERDUE
  MOVE LN-VIEW.LV  TO #P-LOAN-RECORD.#P-TOTAL-PRINCIPAL-PAID
  MOVE LN-VIEW.LW  TO #P-LOAN-RECORD.#P-TOTAL-INTEREST-PAID
  MOVE LN-VIEW.LX  TO #P-LOAN-RECORD.#P-OVERDUE-PRINCIPAL
  MOVE LN-VIEW.LY  TO #P-LOAN-RECORD.#P-OVERDUE-INTEREST
  MOVE LN-VIEW.LZ  TO #P-LOAN-RECORD.#P-OVERDUE-CHARGES
  MOVE LN-VIEW.ME  TO #P-LOAN-RECORD.#P-OVERDUE-DAYS
  MOVE LN-VIEW.MA  TO #P-LOAN-RECORD.#P-NPA-CATEGORY
  MOVE LN-VIEW.MB  TO #P-LOAN-RECORD.#P-NPA-CLASSIFICATION-DATE
  MOVE LN-VIEW.MC  TO #P-LOAN-RECORD.#P-NPA-PROVISION-PERCENT
  MOVE LN-VIEW.MF  TO #P-LOAN-RECORD.#P-LINKED-CASA-ACCOUNT
  MOVE LN-VIEW.MG  TO #P-LOAN-RECORD.#P-COLLATERAL-CODE
  MOVE LN-VIEW.MH  TO #P-LOAN-RECORD.#P-COLLATERAL-VALUE
  MOVE LN-VIEW.MJ  TO #P-LOAN-RECORD.#P-PROCESSING-BRANCH
  MOVE LN-VIEW.MK  TO #P-LOAN-RECORD.#P-LOAN-OFFICER-ID
  MOVE LN-VIEW.MP  TO #P-LOAN-RECORD.#P-RESTRUCTURE-FLAG
  MOVE LN-VIEW.MR  TO #P-LOAN-RECORD.#P-RESTRUCTURE-COUNT
  MOVE LN-VIEW.FF  TO #P-LOAN-RECORD.#P-RECORD-VERSION

  MOVE *ISN        TO #LN-ISN       /* Retain ISN for H-mode UPDATE caller

  MOVE 0000        TO #P-RESPONSE-CODE
  MOVE 'LOAN MASTER READ SUCCESSFUL' TO #P-RESPONSE-TEXT
  MOVE 0           TO #P-ADABAS-RESPONSE

  ESCAPE ROUTINE              /* Exit FIND loop after first (unique) record

END-SUBROUTINE

END